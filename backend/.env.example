# Copy to backend/.env and fill in real values. NEVER commit backend/.env.
FLASK_ENV=development

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET_KEY=

# Access token lifetime in minutes, refresh token lifetime in days.
JWT_ACCESS_MINUTES=45
JWT_REFRESH_DAYS=7

# Comma separated list. Never use "*" together with credentials.
ALLOWED_ORIGINS=http://localhost:3015,http://127.0.0.1:3015

# SQLite file location
LIONEL_DB_PATH=lionel.db

# 5 login attempts per minute per IP + account identifier.
LOGIN_RATE_LIMIT=5 per minute
RATELIMIT_ENABLED=true

# Bootstrap credentials used only by seed_lionel.py (change immediately).
SEED_CEO_PASSWORD=
SEED_OPS_PASSWORD=
SEED_SUPERVISOR_PASSWORD=
SEED_GUARD_PASSWORD=
